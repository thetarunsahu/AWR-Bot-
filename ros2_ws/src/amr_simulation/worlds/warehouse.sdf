<?xml version="1.0"?>
<sdf version="1.9">
  <world name="warehouse">
    <physics name="physics" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <gravity>0 0 -9.8</gravity>
    <light type="directional" name="sun"><cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.5 0.1 -0.9</direction></light>

    <model name="ground_plane"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>30 22</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>30 22</size></plane></geometry></visual></link></model>
    <model name="wall_north"><static>true</static><pose>0 10.5 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>28 0.25 2</size></box></geometry></collision><visual name="v"><geometry><box><size>28 0.25 2</size></box></geometry></visual></link></model>
    <model name="wall_south"><static>true</static><pose>0 -10.5 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>28 0.25 2</size></box></geometry></collision><visual name="v"><geometry><box><size>28 0.25 2</size></box></geometry></visual></link></model>
    <model name="wall_east"><static>true</static><pose>13.9 0 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.25 21 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.25 21 2</size></box></geometry></visual></link></model>
    <model name="wall_west"><static>true</static><pose>-13.9 0 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.25 21 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.25 21 2</size></box></geometry></visual></link></model>

    <model name="rack_a"><static>true</static><pose>-7 4 0.9 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>5 1 1.8</size></box></geometry></collision><visual name="v"><geometry><box><size>5 1 1.8</size></box></geometry></visual></link></model>
    <model name="rack_b"><static>true</static><pose>0 4 0.9 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>5 1 1.8</size></box></geometry></collision><visual name="v"><geometry><box><size>5 1 1.8</size></box></geometry></visual></link></model>
    <model name="rack_c"><static>true</static><pose>7 4 0.9 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>5 1 1.8</size></box></geometry></collision><visual name="v"><geometry><box><size>5 1 1.8</size></box></geometry></visual></link></model>
    <model name="rack_d"><static>true</static><pose>-7 -3.5 0.9 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>5 1 1.8</size></box></geometry></collision><visual name="v"><geometry><box><size>5 1 1.8</size></box></geometry></visual></link></model>
    <model name="rack_e"><static>true</static><pose>0 -3.5 0.9 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>5 1 1.8</size></box></geometry></collision><visual name="v"><geometry><box><size>5 1 1.8</size></box></geometry></visual></link></model>
    <model name="rack_f"><static>true</static><pose>7 -3.5 0.9 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>5 1 1.8</size></box></geometry></collision><visual name="v"><geometry><box><size>5 1 1.8</size></box></geometry></visual></link></model>
    <model name="packing_zone_marker"><static>true</static><pose>9 -8 0.025 0 0 0</pose><link name="link"><visual name="v"><geometry><box><size>3 2 0.05</size></box></geometry><material><ambient>0.15 0.55 0.20 1</ambient></material></visual></link></model>
  </world>
